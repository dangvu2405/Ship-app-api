## Testing Requirements

### Feature Test Example

```php
<?php

declare(strict_types=1);

namespace Tests\Feature\Employee;

use Illuminate\Foundation\Testing\RefreshDatabase;
use Tests\TestCase;
use Src\Infrastructure\Persistence\Eloquent\Models\EmployeeModel;
use Src\Infrastructure\Persistence\Eloquent\Models\OfficeModel;
use Src\Infrastructure\Persistence\Eloquent\Models\UserModel;

final class CreateEmployeeTest extends TestCase
{
    use RefreshDatabase;

    private UserModel $user;
    private OfficeModel $office;

    protected function setUp(): void
    {
        parent::setUp();

        $this->user = UserModel::factory()->create();
        $this->office = OfficeModel::factory()->create();
    }

    public function test_can_create_employee_with_valid_data(): void
    {
        $payload = [
            'code' => 'EMP001',
            'name' => 'John Doe',
            'email' => 'john@example.com',
            'phone' => '0901234567',
            'type' => 'office',
            'base_salary' => 15000000,
            'join_date' => '2024-01-01',
            'office_id' => $this->office->id,
        ];

        $response = $this->actingAs($this->user)
            ->postJson('/api/employees', $payload);

        $response->assertStatus(201)
            ->assertJsonStructure([
                'success',
                'message',
                'data' => [
                    'id',
                    'code',
                    'name',
                    'email',
                    'type',
                    'status',
                    'base_salary',
                    'join_date',
                    'office_id',
                    'created_at',
                    'updated_at',
                ],
            ])
            ->assertJson([
                'success' => true,
                'data' => [
                    'code' => 'EMP001',
                    'name' => 'John Doe',
                    'email' => 'john@example.com',
                    'status' => 'active',
                ],
            ]);

        $this->assertDatabaseHas('employees', [
            'code' => 'EMP001',
            'email' => 'john@example.com',
        ]);
    }

    public function test_cannot_create_employee_with_duplicate_email(): void
    {
        EmployeeModel::factory()->create([
            'email' => 'existing@example.com',
            'office_id' => $this->office->id,
        ]);

        $payload = [
            'code' => 'EMP002',
            'name' => 'Jane Doe',
            'email' => 'existing@example.com',
            'type' => 'office',
            'base_salary' => 15000000,
            'join_date' => '2024-01-01',
            'office_id' => $this->office->id,
        ];

        $response = $this->actingAs($this->user)
            ->postJson('/api/employees', $payload);

        $response->assertStatus(422)
            ->assertJsonValidationErrors(['email']);
    }

    public function test_cannot_create_employee_without_authentication(): void
    {
        $payload = [
            'code' => 'EMP001',
            'name' => 'John Doe',
            'email' => 'john@example.com',
            'type' => 'office',
            'base_salary' => 15000000,
            'join_date' => '2024-01-01',
            'office_id' => $this->office->id,
        ];

        $response = $this->postJson('/api/employees', $payload);

        $response->assertStatus(401);
    }
}
```

### Unit Test Example

```php
<?php

declare(strict_types=1);

namespace Tests\Unit\Application\Employee;

use PHPUnit\Framework\TestCase;
use PHPUnit\Framework\MockObject\MockObject;
use Src\Application\Employee\UseCases\CreateEmployeeUseCase;
use Src\Application\Employee\DTOs\CreateEmployeeData;
use Src\Domain\Employee\Repositories\EmployeeRepositoryInterface;
use Src\Domain\Employee\Exceptions\EmployeeAlreadyExistsException;
use Src\Application\Shared\Contracts\TransactionManagerInterface;
use Src\Application\Shared\Contracts\EventDispatcherInterface;
use Psr\Log\LoggerInterface;

final class CreateEmployeeUseCaseTest extends TestCase
{
    private MockObject&EmployeeRepositoryInterface $employeeRepository;
    private MockObject&TransactionManagerInterface $transactionManager;
    private MockObject&EventDispatcherInterface $eventDispatcher;
    private MockObject&LoggerInterface $logger;
    private CreateEmployeeUseCase $useCase;

    protected function setUp(): void
    {
        $this->employeeRepository = $this->createMock(EmployeeRepositoryInterface::class);
        $this->transactionManager = $this->createMock(TransactionManagerInterface::class);
        $this->eventDispatcher = $this->createMock(EventDispatcherInterface::class);
        $this->logger = $this->createMock(LoggerInterface::class);

        $this->transactionManager
            ->method('execute')
            ->willReturnCallback(fn(callable $callback) => $callback());

        $this->useCase = new CreateEmployeeUseCase(
            $this->employeeRepository,
            $this->transactionManager,
            $this->eventDispatcher,
            $this->logger
        );
    }

    public function test_creates_employee_successfully(): void
    {
        $data = new CreateEmployeeData(
            code: 'EMP001',
            name: 'John Doe',
            email: 'john@example.com',
            type: 'office',
            baseSalary: 15000000,
            joinDate: '2024-01-01',
            officeId: 1
        );

        $this->employeeRepository
            ->expects($this->once())
            ->method('existsByEmail')
            ->willReturn(false);

        $this->employeeRepository
            ->expects($this->once())
            ->method('existsByCode')
            ->willReturn(false);

        $this->employeeRepository
            ->expects($this->once())
            ->method('save');

        $this->eventDispatcher
            ->expects($this->once())
            ->method('dispatch');

        $this->logger
            ->expects($this->once())
            ->method('info');

        $result = $this->useCase->execute($data);

        $this->assertEquals('EMP001', $result->code);
        $this->assertEquals('John Doe', $result->name);
        $this->assertEquals('john@example.com', $result->email);
        $this->assertEquals('active', $result->status);
    }

    public function test_throws_exception_when_email_exists(): void
    {
        $data = new CreateEmployeeData(
            code: 'EMP001',
            name: 'John Doe',
            email: 'existing@example.com',
            type: 'office',
            baseSalary: 15000000,
            joinDate: '2024-01-01',
            officeId: 1
        );

        $this->employeeRepository
            ->expects($this->once())
            ->method('existsByEmail')
            ->willReturn(true);

        $this->expectException(EmployeeAlreadyExistsException::class);

        $this->useCase->execute($data);
    }
}
```

