## Example cURL Commands

```bash
# Create Employee
curl -X POST http://localhost/api/employees \
  -H "Authorization: Bearer {token}" \
  -H "Content-Type: application/json" \
  -H "Accept: application/json" \
  -d '{
    "code": "EMP001",
    "name": "John Doe",
    "email": "john@example.com",
    "phone": "0901234567",
    "type": "office",
    "base_salary": 15000000,
    "join_date": "2024-01-01",
    "office_id": 1
  }'

# List Employees with filters
curl -X GET "http://localhost/api/employees?page=1&per_page=20&office_id=1&type=driver&keyword=john&sort_by=name&sort_order=asc" \
  -H "Authorization: Bearer {token}" \
  -H "Accept: application/json"

# Get Single Employee
curl -X GET http://localhost/api/employees/{uuid} \
  -H "Authorization: Bearer {token}" \
  -H "Accept: application/json"

# Update Employee
curl -X PUT http://localhost/api/employees/{uuid} \
  -H "Authorization: Bearer {token}" \
  -H "Content-Type: application/json" \
  -H "Accept: application/json" \
  -d '{
    "name": "John Updated",
    "base_salary": 18000000
  }'

# Delete Employee
curl -X DELETE http://localhost/api/employees/{uuid} \
  -H "Authorization: Bearer {token}" \
  -H "Accept: application/json"
```

