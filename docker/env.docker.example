# Sao chép thành .env và chỉnh thêm APP_KEY, SANCTUM nếu cần.
# Docker Compose đặt DB_* qua biến môi trường container (xem docker-compose.yml).
#
# Image Docker mặc định (stage `web`): Nginx + PHP-FPM, HTTP trên 0.0.0.0:$PORT (Render/Fly/Railway gán PORT).
# docker-compose dùng stage `fpm` + service nginx riêng — không cần PORT trong compose.

APP_NAME=ShipAPI
APP_ENV=local
APP_DEBUG=true
# Khớp ship-app: VITE_API_ORIGIN (chỉ origin, không /api)
APP_URL=http://localhost:8080

# Gốc frontend — CORS (có thể nhiều URL, CSV). Khớp Vite dev (:3000, :5173, …)
FRONTEND_URL=http://localhost:3000

# Tuỳ chọn: thêm origin (CSV) hoặc regex pattern (CSV), preflight max-age (giây)
# CORS_ALLOWED_ORIGINS=
# CORS_ALLOWED_ORIGIN_PATTERNS=
# CORS_MAX_AGE=0
# CORS_SUPPORTS_CREDENTIALS=true

# Đổi prefix API (mặc định api → /api). Phải sửa ship-app API_PREFIX + bootstrap Laravel nếu đổi.
# API_URI_PREFIX=api

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ship_db
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000

# Attendance
ATTENDANCE_LATE_AFTER=08:15

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Cloudinary
CLOUDINARY_URL=

# Social Login - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Social Login - Facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

# Social Login - Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=
