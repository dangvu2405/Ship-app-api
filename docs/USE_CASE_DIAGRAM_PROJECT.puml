@startuml CompanyShipUseCaseProject
title Company Ship Management System - Project Use Case Overview
left to right direction
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial

actor "Authenticated User" as AuthUser
actor Administrator as Admin
actor "HR Staff" as HR
actor "Operations Staff" as Ops
actor "Payroll Staff" as Payroll
actor "Approver (Manager)" as Approver
actor Driver
actor "Auditor/Compliance" as Auditor
actor "Customer Service Staff" as CS
actor "Identity Provider" as IdP
actor "AI Assistant Service" as AI

rectangle "Company Ship Management System" {
  package "Identity & Access" {
    usecase "Sign In" as UC_SignIn
    usecase "Sign Out" as UC_SignOut
    usecase "Refresh Session" as UC_Refresh
    usecase "View My Profile" as UC_Profile
    usecase "Register User" as UC_Register
    usecase "Manage Roles" as UC_Roles
    usecase "Assign Permissions" as UC_Perms
    usecase "View User Sessions" as UC_ViewSessions
    usecase "Revoke Session" as UC_Revoke
    usecase "Lock Account" as UC_Lock
  }

  package "Master Data & Organization" {
    usecase "Manage Company" as UC_Company
    usecase "Manage Office" as UC_Office
    usecase "Manage Department" as UC_Department
    usecase "Manage Position" as UC_Position
    usecase "Manage User" as UC_User
    usecase "Manage Driver Profile" as UC_DriverProfile
    usecase "Manage Vehicle" as UC_Vehicle
    usecase "Assign Vehicle" as UC_AssignVehicle
  }

  package "Operations & Billing" {
    usecase "Manage Trip" as UC_Trip
    usecase "Update Trip Status" as UC_TripStatus
    usecase "Manage Customer" as UC_Customer
    usecase "Manage Invoice" as UC_Invoice
    usecase "Update Invoice Status" as UC_InvoiceStatus
  }

  package "Workforce" {
    usecase "Create Work Schedule" as UC_CreateSchedule
    usecase "Submit Work Schedule" as UC_SubmitSchedule
    usecase "Approve Work Schedule" as UC_ApproveSchedule
    usecase "Check In" as UC_CheckIn
    usecase "Check Out" as UC_CheckOut
    usecase "Submit Leave Request" as UC_SubmitLeave
    usecase "Approve Leave Request" as UC_ApproveLeave
    usecase "Submit Overtime Request" as UC_SubmitOT
    usecase "Approve Overtime Request" as UC_ApproveOT
  }

  package "Compliance & Payroll" {
    usecase "Report Violation" as UC_ReportViolation
    usecase "Resolve Violation Dispute" as UC_ResolveDispute
    usecase "Calculate Payroll" as UC_CalcPayroll
    usecase "Approve Payroll" as UC_ApprovePayroll
    usecase "Lock Payroll" as UC_LockPayroll
    usecase "Export Payroll" as UC_ExportPayroll
    usecase "View My Salary" as UC_ViewSalary
    usecase "View Audit Action Log" as UC_AuditLog
    usecase "Request Business Advice" as UC_Advice
    usecase "Record User Action" as UC_RecordAction
    usecase "Check Separation of Duties" as UC_CheckSoD
  }
}

AuthUser --> UC_SignIn
AuthUser --> UC_SignOut
AuthUser --> UC_Refresh
AuthUser --> UC_Profile
Admin --> UC_Register
Admin --> UC_Roles
Admin --> UC_Perms
Admin --> UC_ViewSessions
Admin --> UC_Revoke
Admin --> UC_Lock
IdP --> UC_SignIn

Admin --> UC_Company
Admin --> UC_Office
Admin --> UC_Department
Admin --> UC_Position
Admin --> UC_User
HR --> UC_DriverProfile
Ops --> UC_Vehicle
Ops --> UC_AssignVehicle

Ops --> UC_Trip
Ops --> UC_TripStatus
CS --> UC_Customer
CS --> UC_Invoice
CS --> UC_InvoiceStatus

Ops --> UC_CreateSchedule
Ops --> UC_SubmitSchedule
Approver --> UC_ApproveSchedule
Driver --> UC_CheckIn
Driver --> UC_CheckOut
Driver --> UC_SubmitLeave
Approver --> UC_ApproveLeave
Driver --> UC_SubmitOT
Approver --> UC_ApproveOT

Ops --> UC_ReportViolation
Approver --> UC_ResolveDispute
Payroll --> UC_CalcPayroll
Payroll --> UC_ApprovePayroll
Payroll --> UC_LockPayroll
Payroll --> UC_ExportPayroll
Driver --> UC_ViewSalary
Auditor --> UC_AuditLog
AI --> UC_Advice
Admin --> UC_Advice
HR --> UC_Advice
Ops --> UC_Advice
Payroll --> UC_Advice

UC_SignOut ..> UC_RecordAction : <<include>>
UC_Refresh ..> UC_RecordAction : <<include>>
UC_ExportPayroll ..> UC_RecordAction : <<include>>
UC_ApproveSchedule ..> UC_CheckSoD : <<include>>
UC_ApproveLeave ..> UC_CheckSoD : <<include>>
UC_ApproveOT ..> UC_CheckSoD : <<include>>
UC_ApprovePayroll ..> UC_CheckSoD : <<include>>
UC_LockPayroll ..> UC_CheckSoD : <<include>>
UC_Revoke ..> UC_ViewSessions : <<extend>>
UC_Lock ..> UC_ViewSessions : <<extend>>

@enduml
