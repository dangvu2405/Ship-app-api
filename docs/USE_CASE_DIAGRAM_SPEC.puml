@startuml WorkforceManagement
title Company Ship - Workforce Management
top to bottom direction
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial

actor Driver
actor "HR Staff" as HR
actor "Operations Staff" as Ops
actor "Approver (Manager)" as Approver

rectangle "Company Ship Management System" {
  package "Scheduling" {
    usecase "Create Work Schedule" as UC_CreateSchedule
    usecase "Submit Work Schedule" as UC_SubmitSchedule
    usecase "Approve Work Schedule" as UC_ApproveSchedule
    usecase "Reject Work Schedule" as UC_RejectSchedule
    usecase "Lock Work Schedule Period" as UC_LockSchedule
    usecase "Override Work Schedule Lock" as UC_OverrideLock
  }
  package "Attendance" {
    usecase "Check In" as UC_CheckIn
    usecase "Check Out" as UC_CheckOut
    usecase "Adjust Attendance" as UC_AdjustAttendance
    usecase "Review Late Attendance" as UC_ReviewLate
  }
  package "Leave & Overtime" {
    usecase "Submit Leave Request" as UC_SubmitLeave
    usecase "Approve Leave Request" as UC_ApproveLeave
    usecase "Reject Leave Request" as UC_RejectLeave
    usecase "Cancel Leave Request" as UC_CancelLeave
    usecase "Submit Overtime Request" as UC_SubmitOT
    usecase "Approve Overtime Request" as UC_ApproveOT
    usecase "Reject Overtime Request" as UC_RejectOT
  }
  usecase "Check Separation of Duties" as UC_CheckSoD
}

Ops --> UC_CreateSchedule
Ops --> UC_SubmitSchedule
Approver --> UC_ApproveSchedule
Approver --> UC_RejectSchedule
Approver --> UC_LockSchedule
Approver --> UC_OverrideLock
Driver --> UC_CheckIn
Driver --> UC_CheckOut
HR --> UC_AdjustAttendance
HR --> UC_ReviewLate
Driver --> UC_SubmitLeave
Driver --> UC_CancelLeave
Approver --> UC_ApproveLeave
Approver --> UC_RejectLeave
Driver --> UC_SubmitOT
Approver --> UC_ApproveOT
Approver --> UC_RejectOT

UC_ApproveSchedule ..> UC_CheckSoD : <<include>>
UC_ApproveLeave ..> UC_CheckSoD : <<include>>
UC_ApproveOT ..> UC_CheckSoD : <<include>>
UC_LockSchedule ..> UC_ApproveSchedule : <<extend>>
UC_OverrideLock ..> UC_LockSchedule : <<extend>>
UC_RejectSchedule ..> UC_SubmitSchedule : <<extend>>
UC_RejectLeave ..> UC_SubmitLeave : <<extend>>
UC_RejectOT ..> UC_SubmitOT : <<extend>>
@enduml

