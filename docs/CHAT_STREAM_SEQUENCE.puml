@startuml ChatMessagesStreamFlow
title Chat Stream Flow - /api/v1/chat/messages/stream
autonumber
skinparam shadowing false
skinparam defaultFontName Arial

actor "Frontend (FE)" as FE
participant "API Gateway\n(Auth: Sanctum)" as API
participant "ChatController" as Controller
participant "ChatService" as Service
participant "Cache" as Cache
database "chat_messages" as DB
participant "GeminiService" as LLM

FE -> API: POST /api/v1/chat/messages/stream\n{session_id?, message, context?, task?, model?}
API -> Controller: stream(request)
Controller -> Service: streamSend(user, payload)
Service -> Service: send(user, payload)

alt message invalid (<3 chars / empty)
  Service -> DB: insert(status=success, model=local-guard)
  Service --> Controller: guarded response
else message valid
  Service -> Cache: get(cacheKey)
  alt cache hit
    Service -> DB: insert(status=success, cached=true)
    Service --> Controller: response_text (cached)
  else cache miss
    Service -> DB: read recent history by session_id (limit 10)
    Service -> LLM: generateContent(prompt, config)
    alt LLM success
      Service -> Cache: put(cacheKey, response_text, 5m)
      Service -> DB: insert(status=success)
      Service --> Controller: response_text
    else LLM rate-limit/error
      Service -> DB: insert(status=error|fallback)
      Service --> Controller: fallback or error payload
    end
  end
end

Controller --> FE: SSE event: meta {session_id, cached, guarded}
loop each chunk (40 chars)
  Controller --> FE: SSE event: chunk {index, text}
end
Controller --> FE: SSE event: done {result, response_text}

@enduml
