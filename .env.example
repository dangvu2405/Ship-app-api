APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8080
SANCTUM_TOKEN_EXPIRATION=60
SANCTUM_TOKEN_PREFIX=

# CORS / Frontend
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_PATTERNS=
CORS_MAX_AGE=0
CORS_SUPPORTS_CREDENTIALS=true

# API prefix
API_URI_PREFIX=api

# Attendance
ATTENDANCE_LATE_AFTER=08:15

# GET /api/auth/test-accounts (và /api/v1/...) — mặc định chỉ bật route khi APP_ENV=local|testing; staging demo: true
SHOW_TEST_ACCOUNTS=false

# php artisan db:seed --class=BulkDataSeeder (rows per table group; default 100)
BULK_SEED_COUNT=100

# Security
SHIP_ENCRYPT_PII=false

# Queue (database / redis)
DB_QUEUE_TABLE=jobs
REDIS_QUEUE=default

# Payroll
PAYROLL_INSURANCE_PERCENT=0.105
PAYROLL_TAX_PERCENT=0
PAYROLL_DEFAULT_ALLOWANCE=0

# Groq (OpenAI-compatible Chat Completions API) — primary chatbot LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# RAG / Chatbot
CHATBOT_ENABLED=true
RAG_TOP_K=3
RAG_MAX_CONTEXT_LENGTH=4000
RAG_AGENT_ENABLED=false
RAG_SQL_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

# Cloudinary
CLOUDINARY_URL=

# Social Login - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Map Service
MAP_SERVICE_DRIVER=google
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
GOONG_API_KEY=

# Shipping Fee
SHIPPING_BASE_FEE=15000
SHIPPING_FEE_PER_KM=5000
