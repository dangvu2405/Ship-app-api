modules = ["php-8.2", "bash"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
APP_NAME = "ShipApp"
APP_ENV = "local"
APP_DEBUG = "true"
APP_URL = "http://localhost:5000"
APP_LOCALE = "en"
APP_FALLBACK_LOCALE = "en"
APP_FAKER_LOCALE = "en_US"
APP_MAINTENANCE_DRIVER = "file"
BCRYPT_ROUNDS = "12"
LOG_CHANNEL = "stack"
LOG_STACK = "single"
LOG_DEPRECATIONS_CHANNEL = "null"
LOG_LEVEL = "debug"
DB_CONNECTION = "sqlite"
SESSION_DRIVER = "database"
SESSION_LIFETIME = "120"
SESSION_ENCRYPT = "false"
SESSION_PATH = "/"
SESSION_DOMAIN = "null"
SESSION_SECURE_COOKIE = "false"
SESSION_SAME_SITE = "lax"
BROADCAST_CONNECTION = "log"
FILESYSTEM_DISK = "local"
QUEUE_CONNECTION = "database"
CACHE_STORE = "database"
MAIL_MAILER = "log"
MAIL_FROM_ADDRESS = "hello@example.com"
MAIL_FROM_NAME = "ShipApp"
SANCTUM_STATEFUL_DOMAINS = "localhost,localhost:3000,127.0.0.1,127.0.0.1:8080"
SANCTUM_TOKEN_EXPIRATION = "60"
SANCTUM_TOKEN_PREFIX = ""
FRONTEND_URL = "http://localhost:3000"
CORS_ALLOWED_ORIGINS = ""
CORS_ALLOWED_ORIGIN_PATTERNS = ""
CORS_MAX_AGE = "0"
CORS_SUPPORTS_CREDENTIALS = "true"
API_URI_PREFIX = "api"
ATTENDANCE_LATE_AFTER = "08:15"
SHOW_TEST_ACCOUNTS = "false"
BULK_SEED_COUNT = "100"
SHIP_ENCRYPT_PII = "false"
DB_QUEUE_TABLE = "jobs"
PAYROLL_INSURANCE_PERCENT = "0.105"
PAYROLL_TAX_PERCENT = "0"
PAYROLL_DEFAULT_ALLOWANCE = "0"
GEMINI_MODEL = "gemini-2.0-flash"
GEMINI_BASE_URL = "https://generativelanguage.googleapis.com/v1beta"
GROQ_MODEL = "openai/gpt-oss-20b"
GROQ_BASE_URL = "https://api.groq.com/openai/v1"
MAP_SERVICE_DRIVER = "google"
SHIPPING_BASE_FEE = "15000"
SHIPPING_FEE_PER_KM = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "php artisan serve --host=0.0.0.0 --port=5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["php", "artisan", "serve", "--host=0.0.0.0", "--port=5000"]
